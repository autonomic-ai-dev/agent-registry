{
  "version": 1,
  "workflows": {
    "release-notes": {
      "description": "Tag diff → changelog → review gate",
      "path": "workflows/release-notes.yaml",
      "organ": "agent-spine",
      "invoke": "agent-spine init --with @release-notes",
      "fallback": "bash scripts/run-workflow.sh run workflows/release-notes.yaml"
    },
    "stacked-pr": {
      "description": "Rebase stacked branches → resolve conflicts → verify",
      "path": "workflows/stacked-pr.yaml",
      "organ": "agent-spine",
      "invoke": "agent-spine init --with @stacked-pr",
      "fallback": "bash scripts/run-workflow.sh run workflows/stacked-pr.yaml"
    },
    "bugfix": {
      "description": "Reproduce → isolate → fix → verify loop",
      "path": "workflows/bugfix.yaml",
      "organ": "agent-spine",
      "invoke": "agent-spine init --with @bugfix",
      "fallback": "bash scripts/run-workflow.sh run workflows/bugfix.yaml"
    },
    "mcp-health-check": {
      "description": "agent-brain doctor, skill_search probe, and route_task routing verify",
      "path": "workflows/mcp-health-check.yaml",
      "organ": "agent-spine",
      "invoke": "agent-spine init --with @mcp-health-check",
      "fallback": "bash scripts/run-workflow.sh run workflows/mcp-health-check.yaml"
    },
    "feature": {
      "description": "Context & intent → domain model → 4-H2 contract → implement → verify → security gate → review gate",
      "path": "workflows/feature.yaml",
      "organ": "agent-spine",
      "invoke": "agent-spine init --with @feature",
      "fallback": "bash scripts/run-workflow.sh run workflows/feature.yaml"
    },
    "gstack": {
      "description": "YC office hours → autoplan → eng review → design review → CEO review gate → QA lead",
      "path": "workflows/gstack.yaml",
      "organ": "agent-spine",
      "invoke": "agent-spine init --with @gstack",
      "fallback": "bash scripts/run-workflow.sh run workflows/gstack.yaml"
    },
    "minimalist-entrepreneur": {
      "description": "Community discovery → problem validation → build minimal MVP → customer signoff gate → processize & scale",
      "path": "workflows/minimalist-entrepreneur.yaml",
      "organ": "agent-spine",
      "invoke": "agent-spine init --with @minimalist-entrepreneur",
      "fallback": "bash scripts/run-workflow.sh run workflows/minimalist-entrepreneur.yaml"
    }
  }
}
